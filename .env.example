APP_NAME=FlowSync
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_STORAGE_PREFIX=flowsync

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Isolated multi-tenancy (Phase 12/13): central system DB + one DB per tenant.
# Default local fast-path = sqlite (system DB in-memory/file + one sqlite file
# per tenant under TENANT_DB_PATH). Set TENANCY_DRIVER=isolated + TENANT_DB_DRIVER=pgsql
# when running against PostgreSQL (one tenant DB per tenant).
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_SYSTEM_DATABASE=flowsync_system
DB_TENANT_DATABASE=flowsync_tenant

TENANCY_DRIVER=isolated
TENANT_DB_DRIVER=sqlite
TENANT_DB_PATH=database/tenants
# Optional pg_trgm GIN indexes behind LIKE '%q%' search (Phase 2). Off by
# default: CREATE EXTENSION needs a role allowed to install extensions, and
# sqlite has no trigram operators (so the test suite never builds them).
# Enable on PostgreSQL tenants, then re-run: php artisan tenants:provision
ENABLE_TRGM=false
# SESSION_CONNECTION / DB_CACHE_CONNECTION / DB_QUEUE_CONNECTION default to the
# central connection when unset; pin them to 'system' for PG deployments:
# SESSION_CONNECTION=system
# DB_CACHE_CONNECTION=system
# DB_QUEUE_CONNECTION=system

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Production: SESSION_ENCRYPT=true and SESSION_SECURE_COOKIE=true (HTTPS only).
# SESSION_SECURE_COOKIE is unset here so plain-http local dev keeps working.
SESSION_ENCRYPT=false
#SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail Configuration
# Default is 'log' for development/testing.
# Production SMTP options with free tiers (~3,000 to 9,000 free emails/month):
#   - Brevo (Sendinblue): 300 emails/day (~9,000/mo) free. Host: smtp-relay.brevo.com, Port: 587
#   - Resend: 3,000 emails/mo free. Host: smtp.resend.com, Port: 587
#   - MailerSend: 3,000 emails/mo free. Host: smtp.mailersend.net, Port: 587
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notifications@flowsync.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Billing & Payment Gateways (Phase 6 / Phase 14)
# Drivers: 'auto' routes based on currency/locale (INR -> Razorpay, others -> Stripe),
# or force 'stripe', 'razorpay', or 'fake' for tests.
# In production, use live keys (pk_live_..., sk_live_..., whsec_... for Stripe,
# and rzp_live_... for Razorpay).
# ---------------------------------------------------------------------------
PAYMENT_CURRENCY=usd
PAYMENT_DRIVER=auto

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
REVERB_APP_MAX_MESSAGE_SIZE=10000

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
