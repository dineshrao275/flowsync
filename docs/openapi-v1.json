{
  "openapi": "3.0.3",
  "info": {
    "title": "FlowSync API",
    "version": "1.0.0",
    "description": "Bearer-token API. Create a personal API token in Settings → API tokens (needs the API module). A token carries abilities and may be read-only; its effective rights are its abilities AND what its owner still holds. Errors: 401 for any bad credential (indistinguishable by design), 403 for missing ability/module/permission, 422 for validation, 429 when the per-token rate limit is exceeded."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "fst_<tenant>_<token>"
      }
    },
    "parameters": {
      "project": {
        "name": "project",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      "workspace": {
        "name": "workspace",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      "task": {
        "name": "task",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      "key": {
        "name": "key",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "idempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "Repeating a POST with the same key, token and payload returns the stored response instead of creating a second record.",
        "schema": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "current_page": {
            "type": "integer"
          },
          "last_page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "key": {
            "type": "string",
            "example": "APP-12"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "status_id": {
            "type": "integer"
          },
          "priority_id": {
            "type": "integer",
            "nullable": true
          },
          "assignee_id": {
            "type": "integer",
            "nullable": true
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "estimate_minutes": {
            "type": "integer",
            "nullable": true
          },
          "story_points": {
            "type": "integer",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TaskInput": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "string"
          },
          "status_id": {
            "type": "integer"
          },
          "priority_id": {
            "type": "integer"
          },
          "assignee_id": {
            "type": "integer"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "estimate_minutes": {
            "type": "integer"
          },
          "story_points": {
            "type": "integer"
          }
        }
      }
    }
  },
  "paths": {
    "/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Caller identity, token metadata, enabled modules and usage",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Invalid or expired token"
          }
        }
      }
    },
    "/workspaces": {
      "get": {
        "operationId": "listWorkspaces",
        "summary": "List workspaces the caller can access",
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Missing ability or module"
          }
        }
      }
    },
    "/workspaces/{workspace}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/workspace"
        }
      ],
      "get": {
        "operationId": "getWorkspace",
        "summary": "Get workspace details",
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Missing ability or module"
          },
          "404": {
            "description": "Workspace not found"
          }
        }
      }
    },
    "/projects": {
      "get": {
        "operationId": "listProjects",
        "summary": "Projects the token's owner can see",
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Missing ability or module"
          }
        }
      }
    },
    "/projects/{project}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/project"
        }
      ],
      "get": {
        "operationId": "getProject",
        "summary": "Get project details with statuses and members",
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Missing ability or module"
          },
          "404": {
            "description": "Project not found"
          }
        }
      }
    },
    "/projects/{project}/sprints": {
      "parameters": [
        {
          "$ref": "#/components/parameters/project"
        }
      ],
      "get": {
        "operationId": "listSprints",
        "summary": "List project sprints",
        "description": "Needs the sprints module.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Missing ability or module"
          }
        }
      }
    },
    "/projects/{project}/tasks": {
      "parameters": [
        {
          "$ref": "#/components/parameters/project"
        }
      ],
      "get": {
        "operationId": "listTasks",
        "summary": "List a project's tasks",
        "description": "Use view=list for a paginated list (per_page ≤ 100). Filters: status_id, priority_id, assignee_id, label_id, issue_type_id, version_id, epic_id, component_id, sprint, q, due_from, due_to, cf[key], jql (advanced query; needs the JQL module).",
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "board",
                "list"
              ]
            }
          },
          {
            "name": "jql",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 1000
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 100
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "No access to the project"
          },
          "422": {
            "description": "Invalid filter or query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createTask",
        "summary": "Create a task",
        "description": "Requires a write token. Send an Idempotency-Key header to make retries safe.",
        "parameters": [
          {
            "$ref": "#/components/parameters/idempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "task": {
                      "$ref": "#/components/schemas/Task"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Read-only token or no permission"
          },
          "422": {
            "description": "Validation failed"
          }
        }
      }
    },
    "/projects/{project}/tasks/key/{key}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/project"
        },
        {
          "$ref": "#/components/parameters/key"
        }
      ],
      "get": {
        "operationId": "getTaskByKey",
        "summary": "Get task by project key (e.g. QA-12)",
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Missing ability or no access"
          },
          "404": {
            "description": "Task not found"
          }
        }
      }
    },
    "/projects/{project}/tasks/{task}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/project"
        },
        {
          "$ref": "#/components/parameters/task"
        }
      ],
      "get": {
        "operationId": "getTask",
        "summary": "Get task by ID",
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Missing ability or no access"
          },
          "404": {
            "description": "Task not found"
          }
        }
      },
      "put": {
        "operationId": "updateTask",
        "summary": "Update task fields",
        "description": "Requires a write token.",
        "parameters": [
          {
            "$ref": "#/components/parameters/idempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Read-only token or forbidden"
          },
          "422": {
            "description": "Validation or workflow refusal"
          }
        }
      }
    },
    "/projects/{project}/tasks/{task}/comments": {
      "parameters": [
        {
          "$ref": "#/components/parameters/project"
        },
        {
          "$ref": "#/components/parameters/task"
        }
      ],
      "get": {
        "operationId": "listComments",
        "summary": "List task comments",
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Missing ability or no access"
          }
        }
      },
      "post": {
        "operationId": "addComment",
        "summary": "Add a comment to a task",
        "parameters": [
          {
            "$ref": "#/components/parameters/idempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "comment"
                ],
                "properties": {
                  "comment": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "403": {
            "description": "Read-only token or forbidden"
          },
          "422": {
            "description": "Validation failed"
          }
        }
      }
    },
    "/projects/{project}/tasks/{task}/work-logs": {
      "parameters": [
        {
          "$ref": "#/components/parameters/project"
        },
        {
          "$ref": "#/components/parameters/task"
        }
      ],
      "get": {
        "operationId": "listWorkLogs",
        "summary": "List work logs on a task",
        "description": "Needs the time_tracking module.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Missing ability or module"
          }
        }
      },
      "post": {
        "operationId": "logTime",
        "summary": "Log time on a task",
        "description": "Needs the time_tracking module and write token.",
        "parameters": [
          {
            "$ref": "#/components/parameters/idempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "duration_minutes"
                ],
                "properties": {
                  "duration_minutes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "started_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "403": {
            "description": "Read-only token or forbidden"
          },
          "422": {
            "description": "Validation failed"
          }
        }
      }
    },
    "/projects/{project}/tasks/{task}/transitions": {
      "parameters": [
        {
          "$ref": "#/components/parameters/project"
        },
        {
          "$ref": "#/components/parameters/task"
        }
      ],
      "get": {
        "operationId": "getTaskTransitions",
        "summary": "Allowed workflow target statuses and blocker reasons",
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Missing ability or no access"
          }
        }
      }
    },
    "/projects/{project}/tasks/{task}/activities": {
      "parameters": [
        {
          "$ref": "#/components/parameters/project"
        },
        {
          "$ref": "#/components/parameters/task"
        }
      ],
      "get": {
        "operationId": "listTaskActivities",
        "summary": "Audit history and activity feed of a task",
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Missing ability or no access"
          }
        }
      }
    },
    "/projects/{project}/tasks/{task}/move": {
      "parameters": [
        {
          "$ref": "#/components/parameters/project"
        },
        {
          "$ref": "#/components/parameters/task"
        },
        {
          "$ref": "#/components/parameters/idempotencyKey"
        }
      ],
      "post": {
        "operationId": "moveTask",
        "summary": "Move task to another status or position",
        "description": "Returns 200 on immediate move, or 202 if the move requires workflow manager approval.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status_id"
                ],
                "properties": {
                  "status_id": {
                    "type": "integer"
                  },
                  "index": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task moved"
          },
          "202": {
            "description": "Move requested, pending approval"
          },
          "403": {
            "description": "Read-only token or forbidden"
          },
          "422": {
            "description": "Workflow or blocker refusal"
          }
        }
      }
    },
    "/search/tasks": {
      "get": {
        "operationId": "searchTasks",
        "summary": "Search tasks across the projects the owner can see",
        "description": "Needs the global_search module.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Missing module"
          }
        }
      }
    },
    "/hrms/employees": {
      "get": {
        "operationId": "listEmployees",
        "summary": "Employee directory (masked personal fields)",
        "description": "Needs the hrms.view ability and the HRMS core module.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Missing ability or module"
          }
        }
      }
    }
  }
}
