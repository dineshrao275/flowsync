includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
        - routes
    # Existing debt is frozen in phpstan-baseline.neon; new code must not add to it.
    # Regenerate only after fixing errors: composer analyse:baseline
    treatPhpDocTypesAsCertain: false
