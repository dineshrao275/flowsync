{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "flowsync": {
      "type": "local",
      "command": ["node", "/absolute/path/to/flowsync/mcp/src/index.js"],
      "enabled": true,
      "environment": {
        "FLOWSYNC_URL": "http://localhost",
        "FLOWSYNC_TOKEN": "{env:FLOWSYNC_TOKEN}"
      }
    }
  }
}
