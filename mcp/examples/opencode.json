{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "flowsync": {
        "command": "node",
        "args": [
          "/absolute/path/to/flowsync/mcp/src/index.js"
        ],
        "environment": {
          "FLOWSYNC_URL": "http://localhost",
          "FLOWSYNC_TOKEN": "${FLOWSYNC_TOKEN}"
        }
      }
    }
  }
}
