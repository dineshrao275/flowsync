# Template: deploy.sh renders this into .env.production on the server with generated secrets.
# __NAME__ placeholders are replaced; nothing real is ever committed.
APP_NAME=FlowSync
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=http://__PUBLIC_HOST__
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=system
DB_HOST=db
DB_PORT=5432
DB_DATABASE=flowsync_system
DB_USERNAME=flowsync
DB_PASSWORD=__DB_PASSWORD__
DB_SSLMODE=disable
DB_SYSTEM_DATABASE=flowsync_system
DB_TENANT_DATABASE=flowsync_system

TENANCY_DRIVER=isolated
TENANT_DB_DRIVER=pgsql
TENANT_DB_PREFIX=flowsync_tenant_

SESSION_CONNECTION=system
DB_CACHE_CONNECTION=system
DB_QUEUE_CONNECTION=system
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Plain HTTP until a domain + certificate exist; set to true together with https in APP_URL.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Caddy is the only thing in front of the app; trust its forwarded client IP.
TRUSTED_PROXIES=*

# No mail provider configured: messages go to the log until SMTP/SES is set up.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@flowsync.app"
MAIL_FROM_NAME="FlowSync"

# Payments stay in mock mode until real keys are added on the server.
STRIPE_SECRET=
STRIPE_KEY=
STRIPE_WEBHOOK_SECRET=
ONBOARDING_REQUIRE_CARD=false

REVERB_APP_ID=__REVERB_APP_ID__
REVERB_APP_KEY=__REVERB_APP_KEY__
REVERB_APP_SECRET=__REVERB_APP_SECRET__
REVERB_HOST=__PUBLIC_HOST__
REVERB_PORT=80
REVERB_SCHEME=http
REVERB_API_HOST=reverb
REVERB_API_PORT=8080
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# First-boot platform administrator (used once by ProductionSeeder; change the password after first login).
SUPERADMIN_EMAIL=__SUPERADMIN_EMAIL__
SUPERADMIN_PASSWORD=__SUPERADMIN_PASSWORD__

# Compose substitution (build args + postgres): same values as above.
PUBLIC_HOST=__PUBLIC_HOST__
