APP_NAME=FlowSync
APP_ENV=production
APP_KEY=base64:kVnk8ax6TFdG0nuiHNg3VDBGMIKkNTSBysGQshEw8lo=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (isolated tenancy — per-tenant Postgres databases + central system DB)
# ---------------------------------------------------------------------------
DB_CONNECTION=system
DB_HOST=db
DB_PORT=5432
DB_DATABASE=flowsync_system
DB_USERNAME=flowsync
DB_PASSWORD=secret
DB_SSLMODE=disable

# Named connections used by TenantDatabaseManager / config/database.php
DB_SYSTEM_DATABASE=flowsync_system
DB_TENANT_DATABASE=flowsync_system

# Tenancy driver: 'isolated' = one Postgres database per tenant (created on provisioning)
TENANCY_DRIVER=isolated
TENANT_DB_DRIVER=pgsql
TENANT_DB_PREFIX=flowsync_tenant_

# Sessions, cache and queue storage live in the central system database
SESSION_CONNECTION=system
DB_CACHE_CONNECTION=system
DB_QUEUE_CONNECTION=system

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@flowsync.app"
MAIL_FROM_NAME="FlowSync"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Laravel Reverb (WebSockets) — baked into JS bundle at build time
# REVERB_HOST must be the hostname the BROWSER can reach (localhost for local)
# REVERB_SERVER_HOST is what the reverb process binds to inside the container
# ---------------------------------------------------------------------------
REVERB_APP_ID=868222
REVERB_APP_KEY=3epdhhaqs959bljmaety
REVERB_APP_SECRET=fm149xisb0ptyrxfq0xj
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_APP_NAME="FlowSync"
VITE_REVERB_APP_KEY=3epdhhaqs959bljmaety
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
